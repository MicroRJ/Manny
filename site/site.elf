prepare := {
	name = "prepare website directory",
	command_line = "cmd /c if not exist build\\site mkdir build\\site",
	inputs = {},
	outputs = { "build/site" },
	include_dirs = {},
	dependencies = {},
}

targets := {}
for asset := { "style.css", ".nojekyll" }[...] ? {
	copy := {
		name = f"copy website asset ${asset}",
		command_line = f"cmd /d /c copy /Y site\\${asset} build\\site\\${asset} >nul",
		inputs = { f"site/${asset}" },
		outputs = { f"build/site/${asset}" },
		include_dirs = {},
		dependencies = { prepare },
	}
	targets:add(copy)
}

generate := {
	name = "generate website",
	command_line = "pandoc docs/human.md docs/guide.md --from=markdown --to=html5 --standalone --syntax-highlighting=none --wrap=none --template=site/index.html --output=build/site/index.html",
	inputs = {
		"site/index.html",
		"docs/human.md",
		"docs/guide.md",
	},
	outputs = { "build/site/index.html" },
	include_dirs = {},
	dependencies = { prepare },
}
targets:add(generate)

ret targets
