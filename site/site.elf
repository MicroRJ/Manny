ret fun() {
	elf.assert(elf.fs.create_directories("build/site"), "could not create build/site")
	assets := [ "index.html", ".nojekyll" ]
	for asset := assets[...] ? {
		elf.assert(elf.fs.copy_file(f"site/${asset}", f"build/site/${asset}", true), f"could not copy website asset '${asset}'")
	}
	ret 1
}
