
c ::= manny.load("c")

message ::= c.static_library({
	name = "message",
	sources = { "message.c" },
	public_include_directories = { "." },
})

hello ::= c.executable({
	name = "hello",
	sources = { "main.c" },
	dependencies = { message },
})

run ::= c.run({ target = hello })

options := {
	workers = 4,
	verbosity = 0,
}

entries := {}

entries.build = fun() {
	ret manny.build({
		targets = { hello.task },
		options = options,
	})
}

entries.run = fun() {
	ret manny.build({
		targets = { run },
		options = options,
	})
}

ret entries
