message := {
	kind = "static_library",
	name = "message",
	sources = { "message.c" },
	public_include_directories = { "." },
}

hello := {
	kind = "executable",
	name = "hello",
	sources = { "main.c" },
	dependencies = { message },
}

run := {
	kind = "run",
	name = "run hello",
	target = hello,
}

project := {
	name = "hello",
	default_target = hello,
	targets = {
		message = message,
		hello = hello,
		run = run,
	},
}

tasks := manny.load("c").project_to_tasks(project)

options := {
	workers = 4,
	verbosity = 0,
}

entries := {}

entries.build = fun() {
	ret manny.build({ targets = { tasks.default_task }, options = options })
}

entries.run = fun() {
	ret manny.build({ targets = { tasks.targets.run }, options = options })
}

ret entries
