c_module := elf.load_file("c.elf")
project := elf.load_file("project.elf")

tasks := c_module.project_to_tasks(project, {
	compiler = "clang-cl",
	output_directory = "build",
	compile_options = { "/std:c11", "/Zi", "/Od" },
})

stage_c_module := {
	name = "stage C target module",
	command_line = "cmd /d /c copy /Y c.elf build\\c.elf >nul",
	inputs = { "c.elf" },
	outputs = { "build/c.elf" },
	include_dirs = {},
	dependencies = {},
}

unit_tests := {
	tasks.targets.base_tests,
	tasks.targets.graph_tests,
	tasks.targets.build_tests,
	tasks.targets.record_tests,
	tasks.targets.compiler_tests,
	tasks.targets.script_tests,
}

previous_test := nil
for test := unit_tests[...] ? {
	if previous_test != nil ? { test.dependencies:add(previous_test) }
	previous_test = test
}

run_c_helper_example := {
	name = "run C helper example",
	command_line = "build\\manny.exe build.elf run",
	working_directory = "example",
	inputs = { "../build/manny.exe", "../c.elf", "build.elf", "main.c", "message.c", "message.h" },
	outputs = {},
	include_dirs = {},
	dependencies = { tasks.default_task, stage_c_module, previous_test },
}

run_c_helper_fixture := {
	name = "run C helper integration test",
	command_line = "build\\manny.exe build.elf test",
	working_directory = "tests/fixtures/c_helper",
	inputs = {
		"../../../build/manny.exe", "../../../c.elf", "build.elf", "codegen.c",
		"fixture.c", "fixture_test.c", "main.c", "include/fixture.h",
	},
	outputs = {},
	include_dirs = {},
	dependencies = { run_c_helper_example },
}

site_targets := elf.load_file("site/site.elf")
elf.assert(elf.type_of(site_targets) == "table", "site/site.elf must return its targets")

options := {
	workers = 4,
	verbosity = 0,
}

entries := {}

entries.build = fun() {
	ret manny.build({ targets = { tasks.default_task, stage_c_module }, options = options })
}

entries.test = fun() {
	ret manny.build({ targets = { run_c_helper_fixture }, options = options })
}

entries.stress = fun() {
	ret manny.build({ targets = { tasks.targets.record_stress }, options = options })
}

entries.site = fun() {
	ret manny.build({ targets = site_targets, options = options })
}

format_number := fun(number)
{
	parts := {}
	while number ? {
		parts:add(number % 1000)
		number /= 1000
	}
	formatted := ""
	counter := 0
	for piece := parts:reverse()[...] ? {
		piece_text := f"${piece}"
		if counter ? {
			while piece_text:length() < 3 ? { piece_text = f"0${piece_text}" }
			formatted += ","
		}
		formatted += piece_text
		counter += 1
	}
	ret formatted
}

run_line := fun(command)
{
	result := elf.process.run(command)
	elf.assert(result.success, f"command failed: ${command}\n${result.stderr}")
	elf.assert(result.stdout:length(), f"command produced no output: ${command}")
	ret result.stdout:lines()[0]
}

entries.bless = fun() {
	fs := elf.fs
	elf.assert(fs.is_file("build/manny.exe"), "build/manny.exe does not exist; build Manny before blessing it")
	archive_directory := f"blessed/archive/${manny.version}"
	archive := elf.path.join(archive_directory, "manny.exe")
	elf.assert(fs.create_directories(archive_directory), "could not create the blessed archive directory")
	elf.assert(fs.copy_file("build/manny.exe", archive, true), "could not archive the new blessed Manny")
	elf.assert(fs.copy_file("build/manny.exe", "blessed/manny.exe", true), "could not update blessed/manny.exe; run bless using build/manny.exe")
	elf.printl(f"\x1b[1;33mManny ${manny.version} has been blessed. Go forth and compile.\x1b[0m")
	elf.printl(f"\x1b[2;36mThe sacred binary rests at ${archive}\x1b[0m")

	manny_commit := run_line("git rev-parse HEAD")
	elf_commit := run_line("git -C elf rev-parse HEAD")
	dayan_commit := run_line("git -C dayan-core rev-parse HEAD")
	hash_result := elf.process.run("certutil -hashfile build\\manny.exe SHA256")
	elf.assert(hash_result.success, f"could not hash build/manny.exe\n${hash_result.stderr}")
	hash_lines := hash_result.stdout:lines()
	elf.assert(hash_lines:length() >= 2, "certutil returned invalid hash output")
	sha256 := hash_lines[1]

	file_size := format_number(fs.read_text_file("build/manny.exe"):length())

	manifest := "# Manny Manifest\n"
	manifest += "- target                     := windows-x64\n"
	manifest += f"- manny_version              := ${manny.version}\n"
	manifest += f"- manny_source_commit        := ${manny_commit}\n"
	manifest += "- elf_version                := 0.2.0-dev\n"
	manifest += f"- elf_commit                 := ${elf_commit}\n"
	manifest += f"- dayan_core_commit          := ${dayan_commit}\n"
	manifest += f"- executable_size            := ${file_size} bytes\n"
	manifest += f"- SHA-256                    := ${sha256}\n"
	fs.write_text_file(f"${archive_directory}/manifest.md", manifest)
}

// NOTE(RJ) _DO_NOT_ actually remove this or the tests will fail
entries.pet = fun() {
	elf.printl("*purr*")
}

ret entries
