load_project_tasks ::= fun() {
	c_module := elf.load_file("modules/c.elf")
	project := elf.load_file("project.elf")
	ret c_module.project_to_tasks(project, {
		compiler = "clang-cl",
		output_directory = "build",
		compile_options = [ "/std:c11", "/Zi", "/Od" ],
	})
}

stage_c_module ::= fun() {
	elf.assert(elf.fs.create_directories("build"), "could not create build directory")
	elf.assert(elf.fs.copy_file("modules/c.elf", "build/c.elf", true), "could not stage modules/c.elf")
}

find_targets ::= fun(tasks, prefix) {
	matches := []
	names := tasks.targets:keys()
	names:sort(fun(left, right) ret left:compare(right))

	for name := names[...] ? {
		if name:starts_with(prefix) ? { matches:add(tasks.targets[name]) }
	}

	elf.assert(matches:length() > 0, f"no targets found with prefix '${prefix}'")
	ret matches
}

make_test_target ::= fun(tasks) {
	unit_tests := find_targets(tasks, "unit_test_")

	previous_test := nil
	for test := unit_tests[...] ? {
		if previous_test != nil ? { test.dependencies:add(previous_test) }
		previous_test = test
	}

	run_c_helper_example := {
		name = "run C helper example",
		exec = "build\\manny.exe",
		args = [ "build.elf", "run" ],
		working_directory = "example",
		inputs = [ "../build/manny.exe", "../modules/c.elf", "build.elf", "main.c", "message.c", "message.h" ],
		outputs = [],
		include_dirs = [],
		dependencies = [ tasks.default_task, previous_test ],
	}

	ret {
		name = "run C helper integration test",
		exec = "build\\manny.exe",
		args = [ "build.elf", "test" ],
		working_directory = "tests/fixtures/c_helper",
		inputs = [
			"../../../build/manny.exe", "../../../modules/c.elf", "build.elf", "codegen.c",
			"fixture.c", "fixture_test.c", "main.c", "include/fixture.h",
		],
		outputs = [],
		include_dirs = [],
		dependencies = [ run_c_helper_example ],
	}
}

build_site := elf.load_file("site/site.elf")
elf.assert(elf.type_of(build_site) == "closure", "site/site.elf must return its build function")

options := {
	workers = 4,
	verbosity = 0,
}

entries := {}

entries.build = fun() {
	stage_c_module()
	tasks := load_project_tasks()
	ret manny.build({ targets = [ tasks.default_task ], options = options })
}

entries.test = fun() {
	stage_c_module()
	tasks := load_project_tasks()
	ret manny.build({ targets = [ make_test_target(tasks) ], options = options })
}

entries.stress = fun() {
	tasks := load_project_tasks()
	ret manny.build({ targets = find_targets(tasks, "stress_test_"), options = options })
}

entries.site = fun() {
	ret build_site()
}

format_number := fun(number)
{
	parts := []
	while number ? {
		parts:add(number % 1000)
		number /= 1000
	}
	formatted := ""
	counter := 0
	for piece := parts:reverse()[...] ? {
		piece_text := f"${piece}"
		if counter ? {
			while piece_text:length() < 3 ? { piece_text = f"0${piece_text}" }
			formatted += ","
		}
		formatted += piece_text
		counter += 1
	}
	ret formatted
}

find_executable := fun(name)
{
	if elf.fs.file_exists(name) ? { ret name }
	path := elf.env.get("PATH")
	elf.assert(path != nil, "PATH is not set")
	for directory := path:split(";")[...] ? {
		candidate := elf.path.join(directory, name)
		if elf.fs.file_exists(candidate) ? { ret candidate }
	}
	elf.assert(0, f"could not find executable '${name}'")
}

run_capture := fun(executable, arguments)
{
	executable_path := find_executable(executable)
	pipe_status, reader, writer := elf.io.pipe()
	elf.assert(pipe_status == elf.io.SUCCESS, f"could not create output pipe for '${executable}'")
	process_status, process := elf.process.start(executable_path, arguments, { stdout = writer, hide_window = 1 })
	elf.assert(process_status == elf.io.SUCCESS, f"could not start '${executable}'")
	elf.assert(writer:close() == elf.io.SUCCESS, f"could not close output pipe for '${executable}'")

	output := elf.buffer()
	read_status := elf.io.SUCCESS
	read_count := 0
	while read_status == elf.io.SUCCESS ? {
		read_status, read_count = reader:read(output, 4096)
	}
	elf.assert(read_status == elf.io.END_OF_STREAM, f"could not read output from '${executable}'")
	elf.assert(reader:close() == elf.io.SUCCESS, f"could not close output pipe for '${executable}'")

	process_state, exit_code := process:wait()
	elf.assert(process_state == elf.process.EXITED, f"could not wait for '${executable}'")
	elf.assert(process:close() == elf.io.SUCCESS, f"could not close '${executable}'")
	elf.assert(exit_code == 0, f"'${executable}' exited with code ${exit_code}")
	text := output:to_string():trim()
	elf.assert(text:length(), f"'${executable}' produced no output")
	ret text
}

run_line := fun(executable, arguments)
{
	ret run_capture(executable, arguments):lines()[0]:trim()
}

entries.bless = fun() {
	fs := elf.fs
	elf.assert(fs.is_file("build/manny.exe"), "build/manny.exe does not exist; build Manny before blessing it")
	archive_directory := f"blessed/archive/${manny.version}"
	archive := elf.path.join(archive_directory, "manny.exe")
	elf.assert(fs.create_directories(archive_directory), "could not create the blessed archive directory")
	elf.assert(fs.copy_file("build/manny.exe", archive, true), "could not archive the new blessed Manny")
	elf.assert(fs.copy_file("build/manny.exe", "blessed/manny.exe", true), "could not update blessed/manny.exe; run bless using build/manny.exe")
	elf.printl(f"\x1b[1;33mManny ${manny.version} has been blessed. Go forth and compile.\x1b[0m")
	elf.printl(f"\x1b[2;36mThe sacred binary rests at ${archive}\x1b[0m")

	manny_commit := run_line("git.exe", [ "rev-parse", "HEAD" ])
	elf_commit := run_line("git.exe", [ "-C", "deps/elf", "rev-parse", "HEAD" ])
	dy_commit := run_line("git.exe", [ "-C", "deps/dy-core", "rev-parse", "HEAD" ])
	hash_output := run_capture("certutil.exe", [ "-hashfile", "build\\manny.exe", "SHA256" ])
	hash_lines := hash_output:lines()
	elf.assert(hash_lines:length() >= 2, "certutil returned invalid hash output")
	sha256 := hash_lines[1]:trim()

	file_size := format_number(fs.read_text_file("build/manny.exe"):length())

	manifest := "# Manny Manifest\n"
	manifest += "- target                     := windows-x64\n"
	manifest += f"- manny_version              := ${manny.version}\n"
	manifest += f"- manny_source_commit        := ${manny_commit}\n"
	manifest += "- elf_version                := 0.2.0-dev\n"
	manifest += f"- elf_commit                 := ${elf_commit}\n"
	manifest += f"- dy_core_commit             := ${dy_commit}\n"
	manifest += f"- executable_size            := ${file_size} bytes\n"
	manifest += f"- SHA-256                    := ${sha256}\n"
	fs.write_text_file(f"${archive_directory}/manifest.md", manifest)
}

// NOTE(RJ) _DO_NOT_ actually remove this or the tests will fail
entries.pet = fun() {
	elf.printl("*purr*")
}

ret entries
