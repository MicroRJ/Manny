
core_sources := {
	{ name = "base",               path = "src/base.c"                      },
	{ name = "logger",             path = "src/logger.c"                    },
	{ name = "profiler",           path = "src/profiler.c"                  },
	{ name = "manny_atom",         path = "src/lib/manny_atom.c"           },
	{ name = "manny",              path = "src/lib/manny.c"                },
	{ name = "manny_execution",    path = "src/lib/manny_execution.c"      },
	{ name = "manny_build",        path = "src/lib/manny_build.c"          },
	{ name = "build_record",        path = "src/lib/build_record.c"         },
	{ name = "build_record_stream", path = "src/lib/build_record_stream.c"  },
	{ name = "compiler_command",   path = "src/lib/compiler_command.c"       },
	{ name = "make_depfile",       path = "src/lib/make_depfile.c"           },
	{ name = "vcvars_cache",       path = "src/lib/vcvars_cache.c"          },
	{ name = "script",             path = "src/script.c"                    },
	{ name = "elf_adapter",        path = "src/scripts/elf_adapter.c"       },
	{ name = "platform",           path = "src/platform_adapter.c"          },
}

blake3_sources := {
	{ name = "blake3",          path = "blake3/c/blake3.c"          },
	{ name = "blake3_dispatch", path = "blake3/c/blake3_dispatch.c" },
	{ name = "blake3_portable", path = "blake3/c/blake3_portable.c" },
}

cc := "clang-cl"

include_dirs := {
	"src",
	"src/lib",
	"blake3/c",
	"elf/include",
	"platform/include",
}

compile_options := " /nologo /std:c11 /W4 /WX /Zi /Od"
blake3_compile_options := " /DBLAKE3_NO_SSE2 /DBLAKE3_NO_SSE41 /DBLAKE3_NO_AVX2 /DBLAKE3_NO_AVX512 /DBLAKE3_USE_NEON=0"

include_options := " " + " ":join(include_dirs:map(fun(directory) ret f"/I${directory}"))

prepare := {
	name = "prepare object directory",
	command_line = "cmd /c if not exist build\\obj mkdir build\\obj",
	inputs = {},
	outputs = { "build/obj" },
	include_dirs = {},
	dependencies = {},
}

prepare_tests := {
	name = "prepare test directory",
	command_line = "cmd /c if not exist build\\tests mkdir build\\tests",
	inputs = {},
	outputs = { "build/tests" },
	include_dirs = {},
	dependencies = {},
}

build_elf := {
	name = "build Elf library",
	command_line = "cmd /c \"cd /d elf && ..\\blessed\\manny.exe build.elf lib\"",
	inputs = {},
	outputs = {},
	include_dirs = {},
	dependencies = {},
	transparent = true,
}

compile_source := fun(options) {
	object := f"build/obj/${options.name}.obj"
	pdb := f"build/obj/${options.name}.pdb"
	task := {
		name = f"compile ${options.name}",
		command_line = f"${cc}${compile_options}${options.extra_options}${include_options} /c ${options.source} /Fo${object} /Fd${pdb}",
		inputs = { options.source },
		outputs = { object },
		include_dirs = include_dirs,
		dependencies = { prepare },
	}
	ret { task = task, object = object }
}

common_tasks := {}
common_objects := {}
for source := core_sources[...] ? {
	compiled := compile_source({
		name = source.name,
		source = source.path,
		extra_options = "",
	})
	common_tasks:add(compiled.task)
	common_objects:add(compiled.object)
}
for source := blake3_sources[...] ? {
	compiled := compile_source({
		name = source.name,
		source = source.path,
		extra_options = blake3_compile_options,
	})
	common_tasks:add(compiled.task)
	common_objects:add(compiled.object)
}

build_platform := {
	name = "build platform library",
	command_line = "cmd /c \"cd /d platform && ..\\blessed\\manny.exe build.elf lib\"",
	inputs = {
		"platform/build.elf",
		"platform/include/platform.h",
		"platform/include/platform_types.h",
		"platform/src/platform_win32.c",
	},
	outputs = { "platform/build/platform.lib" },
	include_dirs = {},
	dependencies = {},
	transparent = true,
}

manny_compiled := compile_source({
	name = "manny_main",
	source = "src/manny_main.c",
	extra_options = "",
})
manny_dependencies := common_tasks:clone():extend({
	manny_compiled.task,
	build_elf,
	build_platform,
})
manny_inputs := common_objects:clone():extend({
	manny_compiled.object,
	"elf/build/elf.lib",
	"elf/build/elf_batteries.lib",
	"platform/build/platform.lib",
})
common_object_options := " ":join(common_objects)
common_object_options = f" ${common_object_options}"

build_manny := {
	name = "link Manny",
	command_line = f"${cc} /nologo${common_object_options} ${manny_compiled.object} elf\\build\\elf.lib elf\\build\\elf_batteries.lib platform\\build\\platform.lib /Febuild\\manny.exe /link /DEBUG /PDB:build\\manny.pdb",
	inputs = manny_inputs,
	outputs = { "build/manny.exe" },
	include_dirs = {},
	dependencies = manny_dependencies,
}

stage_c_module := {
	name = "stage C target module",
	command_line = "cmd /d /c copy /Y c.elf build\\c.elf >nul",
	inputs = { "c.elf" },
	outputs = { "build/c.elf" },
	include_dirs = {},
	dependencies = { prepare },
}

test_suites := {
	{ name = "base",     source = "tests/test_base.c"     },
	{ name = "graph",    source = "tests/test_graph.c"    },
	{ name = "build",    source = "tests/test_build.c"    },
	{ name = "record",   source = "tests/test_record.c"   },
	{ name = "compiler", source = "tests/test_compiler.c" },
	{ name = "script",   source = "tests/test_script.c"   },
}

test_support := compile_source({
	name = "test_support", source = "tests/test.c", extra_options = "",
})

test_targets := {}
previous_test := {}
for suite := test_suites[...] ? {
	compiled := compile_source({
		name = f"test_${suite.name}", source = suite.source, extra_options = "",
	})
	executable := f"build/tests/test_${suite.name}.exe"
	pdb := f"build/tests/test_${suite.name}.pdb"
	link := {
		name = f"link ${suite.name} tests",
		command_line = f"${cc} /nologo${common_object_options} ${test_support.object} ${compiled.object} elf\\build\\elf.lib elf\\build\\elf_batteries.lib platform\\build\\platform.lib /Fe${executable} /link /DEBUG /PDB:${pdb}",
		inputs = common_objects:clone():extend({
			test_support.object, compiled.object,
			"elf/build/elf.lib", "elf/build/elf_batteries.lib", "platform/build/platform.lib",
		}),
		outputs = { executable },
		include_dirs = {},
		dependencies = common_tasks:clone():extend({
			test_support.task, compiled.task, prepare_tests, build_elf, build_platform,
		}),
	}
	run := {
		name = f"run ${suite.name} tests",
		command_line = executable,
		inputs = { executable },
		outputs = {},
		include_dirs = {},
		dependencies = { link }:extend(previous_test),
	}
	test_targets = { run }
	previous_test = { run }
}

run_c_helper_example := {
	name = "run C helper example",
	command_line = "build\\manny.exe build.elf run",
	working_directory = "example",
	inputs = { "../build/manny.exe", "../c.elf", "build.elf", "main.c", "message.c", "message.h" },
	outputs = {},
	include_dirs = {},
	dependencies = { build_manny, stage_c_module }:extend(previous_test),
}

run_c_helper_fixture := {
	name = "run C helper integration test",
	command_line = "build\\manny.exe build.elf test",
	working_directory = "tests/fixtures/c_helper",
	inputs = {
		"../../../build/manny.exe", "../../../c.elf", "build.elf", "codegen.c",
		"fixture.c", "fixture_test.c", "main.c", "include/fixture.h",
	},
	outputs = {},
	include_dirs = {},
	dependencies = { run_c_helper_example },
}
test_targets = { run_c_helper_fixture }

stress_compiled := compile_source({
	name = "test_record_stress", source = "tests/test_record_stress.c", extra_options = "",
})
stress_executable := "build/tests/test_record_stress.exe"
build_stress_tests := {
	name = "link record stress tests",
	command_line = f"${cc} /nologo${common_object_options} ${test_support.object} ${stress_compiled.object} elf\\build\\elf.lib elf\\build\\elf_batteries.lib platform\\build\\platform.lib /Fe${stress_executable} /link /DEBUG /PDB:build\\tests\\test_record_stress.pdb",
	inputs = common_objects:clone():extend({
		test_support.object, stress_compiled.object,
		"elf/build/elf.lib", "elf/build/elf_batteries.lib", "platform/build/platform.lib",
	}),
	outputs = { stress_executable },
	include_dirs = {},
	dependencies = common_tasks:clone():extend({
		test_support.task, stress_compiled.task, prepare_tests, build_elf, build_platform,
	}),
}
run_stress_tests := {
	name = "run record stress tests",
	command_line = stress_executable,
	inputs = { stress_executable },
	outputs = {},
	include_dirs = {},
	dependencies = { build_stress_tests },
}

options := {
	workers   = 4,
	verbosity = 0,
}

entries := {}

entries.build = fun() {
	ret manny.build({
		targets = { build_manny, stage_c_module },
		options = options,
	})
}

entries.test = fun() {
	ret manny.build({
		targets = test_targets,
		options = options,
	})
}

entries.stress = fun() {
	ret manny.build({
		targets = { run_stress_tests },
		options = options,
	})
}


format_number := fun(number)
{
	parts := {}
	while number ? {
		parts:add(number % 1000)
		number /= 1000
	}
	formatted := ""
	counter := 0
	for piece := parts:reverse()[...] ? {
		piece_text := f"${piece}"
		if counter ? {
			while piece_text:length() < 3 ? { piece_text = f"0${piece_text}" }
			formatted += ","
		}
		formatted += piece_text
		counter += 1
	}
	ret formatted
}

run_line := fun(command)
{
	result := elf.process.run(command)
	elf.assert(result.success, f"command failed: ${command}\n${result.stderr}")
	elf.assert(result.stdout:length(), f"command produced no output: ${command}")
	ret result.stdout:lines()[0]
}

entries.bless = fun() {
	fs := elf.fs
	elf.assert(fs.is_file("build/manny.exe"), "build/manny.exe does not exist; build Manny before blessing it")
	archive_directory := f"blessed/archive/${manny.version}"
	archive := elf.path.join(archive_directory, "manny.exe")
	elf.assert(fs.create_directories(archive_directory), "could not create the blessed archive directory")
	elf.assert(fs.copy_file("build/manny.exe", archive, true), "could not archive the new blessed Manny")
	elf.assert(fs.copy_file("build/manny.exe", "blessed/manny.exe", true), "could not update blessed/manny.exe; run bless using build/manny.exe")
	elf.printl(f"\x1b[1;33mManny ${manny.version} has been blessed. Go forth and compile.\x1b[0m")
	elf.printl(f"\x1b[2;36mThe sacred binary rests at ${archive}\x1b[0m")

	manny_commit    := run_line("git rev-parse HEAD")
	elf_commit      := run_line("git -C elf rev-parse HEAD")
	platform_commit := run_line("git -C platform rev-parse HEAD")
	hash_result     := elf.process.run("certutil -hashfile build\\manny.exe SHA256")
	elf.assert(hash_result.success, f"could not hash build/manny.exe\n${hash_result.stderr}")
	hash_lines      := hash_result.stdout:lines()
	elf.assert(hash_lines:length() >= 2, "certutil returned invalid hash output")
	sha256          := hash_lines[1]

	file_size := format_number(fs.read_text_file("build/manny.exe"):length())

	manifest := "# Manny Manifest\n"
	manifest += "- target                     := windows-x64\n"
	manifest += f"- manny_version              := ${manny.version}\n"
	manifest += f"- manny_source_commit        := ${manny_commit}\n"
	manifest += "- elf_version                := 0.2.0-dev\n"
	manifest += f"- elf_commit                 := ${elf_commit}\n"
	manifest += "- platform_version           := 0.1.0-dev\n"
	manifest += f"- platform_commit            := ${platform_commit}\n"
	manifest += f"- executable_size            := ${file_size} bytes\n"
	manifest += f"- SHA-256                    := ${sha256}\n"
	fs.write_text_file(f"${archive_directory}/manifest.md", manifest)
}

// NOTE(RJ) _DO_NOT_ actually remove this or the tests will fail
entries.pet = fun() {
	elf.printl("*purr*")
}
ret entries
