codegen := {
	kind = "executable",
	name = "codegen",
	sources = { "codegen.c" },
}

generated := {
	kind = "generated_file",
	name = "generate value header",
	program = codegen,
	output = "generated/value.h",
	arguments = fun(output) {
		ret { output }
	},
}

fixture := {
	kind = "static_library",
	name = "fixture",
	sources = {
		{
			path = "fixture.c",
			generated_inputs = { generated },
		},
	},
	public_include_directories = { "include" },
}

app := {
	kind = "executable",
	name = "fixture_app",
	sources = { "main.c" },
	dependencies = { fixture },
}

tests := {
	kind = "test",
	name = "fixture_tests",
	sources = { "fixture_test.c" },
	dependencies = { fixture },
}

project := {
	name = "fixture",
	default_target = app,
	targets = {
		codegen = codegen,
		generated = generated,
		fixture = fixture,
		app = app,
		tests = tests,
	},
}

tasks := manny.load("c").project_to_tasks(project, {
	compile_options = { "/W4", "/WX" },
})

entries := {}
entries.build = fun() ret manny.build({ targets = { tasks.default_task } })
entries.test = fun() ret manny.build({ targets = { tasks.targets.tests } })
ret entries
