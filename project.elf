working_directory := elf.fs.get_working_directory()
elf.assert(elf.fs.set_working_directory("deps"), "could not enter the dependency directory")
elf_project := elf.load_file("elf/project.elf")
elf.assert(elf.fs.set_working_directory(working_directory), "could not restore the working directory")
elf_project.root = "deps/elf"
elf_project.subprojects.dy.root = "deps/dy-core"

blake3 := {
	kind = "static_library",
	name = "blake3",
	sources = {
		"deps/blake3/c/blake3.c",
		"deps/blake3/c/blake3_dispatch.c",
		"deps/blake3/c/blake3_portable.c",
	},
	public_include_directories = { "deps/blake3/c" },
	defines = {
		"BLAKE3_NO_SSE2",
		"BLAKE3_NO_SSE41",
		"BLAKE3_NO_AVX2",
		"BLAKE3_NO_AVX512",
		"BLAKE3_USE_NEON=0",
	},
}

core := {
	kind = "static_library",
	name = "manny_core",
	sources = {
		"src/logger.c",
		"src/profiler.c",
		"src/graph/manny.c",
		"src/graph/manny_execution.c",
		"src/build/manny_atom.c",
		"src/build/manny_build.c",
		"src/build/build_record.c",
		"src/build/compiler_command.c",
		"src/build/make_depfile.c",
		"src/build/vcvars_cache.c",
		"src/script.c",
		"src/scripts/elf_adapter.c",
		"src/platform_adapter.c",
	},
	public_include_directories = { "src", "src/graph", "src/build" },
	dependencies = { blake3, elf_project },
}

executable := {
	kind = "executable",
	name = "manny",
	sources = { "src/manny_main.c" },
	dependencies = { core },
}

test_support := {
	kind = "static_library",
	name = "manny_test_support",
	sources = { "tests/test.c" },
	dependencies = { core },
}

base_tests := {
	kind = "test",
	name = "test_base",
	sources = { "tests/test_base.c" },
	dependencies = { test_support },
}

graph_tests := {
	kind = "test",
	name = "test_graph",
	sources = { "tests/test_graph.c" },
	dependencies = { test_support },
}

build_tests := {
	kind = "test",
	name = "test_build",
	sources = { "tests/test_build.c" },
	dependencies = { test_support },
}

record_tests := {
	kind = "test",
	name = "test_record",
	sources = { "tests/test_record.c" },
	dependencies = { test_support },
}

compiler_tests := {
	kind = "test",
	name = "test_compiler",
	sources = { "tests/test_compiler.c" },
	dependencies = { test_support },
}

script_tests := {
	kind = "test",
	name = "test_script",
	sources = { "tests/test_script.c" },
	dependencies = { test_support },
}

record_stress := {
	kind = "test",
	name = "test_record_stress",
	sources = { "tests/test_record_stress.c" },
	dependencies = { test_support },
}

ret {
	name = "manny",
	root = ".",
	subprojects = {
		elf = elf_project,
	},
	default_target = executable,
	targets = {
		blake3 = blake3,
		core = core,
		executable = executable,
		test_support = test_support,
		base_tests = base_tests,
		graph_tests = graph_tests,
		build_tests = build_tests,
		record_tests = record_tests,
		compiler_tests = compiler_tests,
		script_tests = script_tests,
		record_stress = record_stress,
	},
}
