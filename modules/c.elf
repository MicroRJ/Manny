// C and C++ targets built on Manny's task graph.

// NOTE(RJ):
//
// This helper describes C and C++ projects at a high level and generates Manny
// tasks from those descriptions.
//
// Proposed public schema:
//
// project :: contract
// {
// 	requirements :: contract
// 	{
// 		includes:        array(str) = {}
// 		defines:         array(str) = {}
// 		libraries:       array(str) = {}
// 		compile_options: array(str) = {}
// 		link_options:    array(str) = {}
// 	}
//
// 	output :: contract
// 	{
// 		name:    str
// 		kind:    choices("library", "executable")
// 		sources: array(str)
// 		deps:    array(ref(output)) = {}
// 		private: requirements = {}
// 		public:  requirements = {}
// 	}
//
// 	root:    str = "."
// 	outputs: array(output)
// }
//
// Dependencies refer directly to other outputs. Private requirements apply
// only while building an output. Public requirements are inherited by outputs
// that depend on it.

project_to_tasks ::= fun(project, options) {
	options = options ?? {}
	style ::= options.style ?? "msvc"
	elf.assert(style == "msvc" || style == "gnu", "C project style must be 'msvc' or 'gnu'")

	default_compiler := "cc"
	default_archiver := "ar"
	default_executable_suffix := ""
	object_suffix := ".o"
	if style == "msvc" ? {
		default_compiler = "clang-cl"
		default_archiver = "lib"
		default_executable_suffix = ".exe"
		object_suffix = ".obj"
	}
	compiler ::= options.compiler ?? default_compiler
	archiver ::= options.archiver ?? default_archiver
	output_directory ::= options.output_directory ?? "build"
	common_compile_options ::= options.compile_options ?? []
	common_link_options ::= options.link_options ?? []
	executable_suffix ::= options.executable_suffix ?? default_executable_suffix

	elf.assert(elf.fs.create_directories(output_directory), f"could not create C project output directory '${output_directory}'")

	clone_table ::= fun(source) {
		result := {}
		for key := source:keys()[...] ? { result[key] = source[key] }
		ret result
	}

	append_prefixed ::= fun(arguments, prefix, values) {
		for value := values[...] ? { arguments:add(prefix + value) }
		ret arguments
	}

	path_directory ::= fun(path) {
		parts := path:replace("\\", "/"):split("/")
		parts:pop()
		if parts:length() == 0 ? ret "."
		ret "/":join(parts)
	}

	object_name ::= fun(source, index) {
		name := source:replace("\\", "_"):replace("/", "_"):replace(":", "_"):replace(".", "_")
		ret f"${index}_${name}${object_suffix}"
	}

	dependency_usage ::= fun(dependencies) {
		include_directories := []
		defines := []
		compile_options := []
		link_options := []
		libraries := []
		tasks := []

		for dependency := dependencies[...] ? {
			elf.assert(elf.type_of(dependency) == "table" && elf.type_of(dependency.task) == "table",
				"C target dependencies must contain targets")
			include_directories:extend(dependency.usage.include_directories)
			defines:extend(dependency.usage.defines)
			compile_options:extend(dependency.usage.compile_options)
			link_options:extend(dependency.usage.link_options)
			libraries:extend(dependency.usage.libraries)
			tasks:add(dependency.task)
		}

		ret {
			include_directories = include_directories,
			defines = defines,
			compile_options = compile_options,
			link_options = link_options,
			libraries = libraries,
			tasks = tasks,
		}
	}

	compile_sources ::= fun(name, sources, description, dependency_info) {
		elf.assert(elf.type_of(sources) == "array", f"c target '${name}' requires a sources array")
		object_directory := f"${output_directory}/obj/${name}"
		elf.assert(elf.fs.create_directories(object_directory), f"could not create '${object_directory}'")

		private_includes := description.private_include_directories ?? []
		public_includes := description.public_include_directories ?? []
		includes := private_includes:slice():extend(public_includes, dependency_info.include_directories)
		defines := (description.defines ?? []):slice():extend(description.public_defines ?? [], dependency_info.defines)
		compile_options := common_compile_options:slice():extend(description.compile_options ?? [], description.public_compile_options ?? [], dependency_info.compile_options)
		target_generated_inputs := description.generated_inputs ?? []
		define_prefix := "-D"
		include_prefix := "-I"
		if style == "msvc" ? {
			define_prefix = "/D"
			include_prefix = "/I"
		}

		objects := []
		tasks := []
		index := 0
		for source := sources[...] ? {
			source_path := source
			generated_inputs := target_generated_inputs:slice()
			if elf.is_string(source) == false ? {
				elf.assert(elf.type_of(source) == "table", f"invalid source in target '${name}'")
				source_path = source.path
				if source.kind == "generated_file" ? { generated_inputs:add(source) }
				generated_inputs:extend(source.generated_inputs ?? [])
			}
			elf.assert(elf.is_string(source_path), f"invalid source path in target '${name}'")

			generated_paths := generated_inputs:map(fun(generated) ret generated.path)
			generated_tasks := generated_inputs:map(fun(generated) ret generated.task)
			generated_includes := generated_paths:map(fun(path) ret path_directory(path))
			source_includes := includes:slice():extend(generated_includes)
			object := f"${object_directory}/${object_name(source_path, index)}"

			arguments := []
			if style == "msvc" ? { arguments:add("/nologo") }
			arguments:extend(compile_options)
			arguments = append_prefixed(arguments, define_prefix, defines)
			arguments = append_prefixed(arguments, include_prefix, source_includes)
			if style == "msvc" ? { arguments:extend([ "/c", source_path, f"/Fo${object}" ]) }
			else { arguments:extend([ "-c", source_path, "-o", object ]) }

			task := {
				name = f"compile ${name}: ${source_path}",
				exec = compiler,
				args = arguments,
				inputs = [ source_path ]:extend(generated_paths),
				outputs = [ object ],
				include_dirs = source_includes,
				dependencies = generated_tasks,
			}
			objects:add(object)
			tasks:add(task)
			index += 1
		}

		ret { objects = objects, tasks = tasks }
	}

	static_library := fun(description) {
		name := description.name
		elf.assert(elf.is_string(name), "static_library target requires a name")
		dependencies := description.dependencies ?? []
		dependency_info := dependency_usage(dependencies)
		compiled := compile_sources(name, description.sources, description, dependency_info)
		output := f"${output_directory}/lib${name}.a"
		if style == "msvc" ? { output = f"${output_directory}/${name}.lib" }

		arguments := []
		if style == "msvc" ? { arguments:extend([ "/nologo", f"/OUT:${output}" ]) }
		else { arguments:extend([ "rcs", output ]) }
		arguments:extend(compiled.objects)

		task := {
			name = f"archive ${name}",
			exec = archiver,
			args = arguments,
			inputs = compiled.objects,
			outputs = [ output ],
			include_dirs = [],
			dependencies = compiled.tasks:slice():extend(dependency_info.tasks),
		}

		ret {
			name = name,
			kind = "static_library",
			output = output,
			task = task,
			usage = {
				include_directories = (description.public_include_directories ?? []):slice():extend(dependency_info.include_directories),
				defines = (description.public_defines ?? []):slice():extend(dependency_info.defines),
				compile_options = (description.public_compile_options ?? []):slice():extend(dependency_info.compile_options),
				link_options = (description.public_link_options ?? []):slice():extend(dependency_info.link_options),
				libraries = [ output ]:extend(dependency_info.libraries),
			},
		}
	}

	executable := fun(description) {
		name := description.name
		elf.assert(elf.is_string(name), "executable target requires a name")
		dependencies := description.dependencies ?? []
		dependency_info := dependency_usage(dependencies)
		compiled := compile_sources(name, description.sources, description, dependency_info)
		output := f"${output_directory}/${name}${executable_suffix}"
		link_options := common_link_options:slice():extend(description.link_options ?? [], dependency_info.link_options)
		link_inputs := compiled.objects:slice():extend(dependency_info.libraries)

		arguments := link_inputs:slice()
		if style == "msvc" ? {
			arguments:add(f"/Fe${output}")
			if link_options:length() ? {
				arguments:add("/link")
				arguments:extend(link_options)
			}
		}
		else {
			arguments:extend(link_options)
			arguments:extend([ "-o", output ])
		}

		task := {
			name = f"link ${name}",
			exec = compiler,
			args = arguments,
			inputs = link_inputs,
			outputs = [ output ],
			include_dirs = [],
			dependencies = compiled.tasks:slice():extend(dependency_info.tasks),
		}

		ret {
			name = name,
			kind = "executable",
			output = output,
			task = task,
			usage = {
				include_directories = [],
				defines = [],
				compile_options = [],
				link_options = [],
				libraries = [],
			},
		}
	}

	generated_file := fun(description) {
		elf.assert(elf.is_string(description.name), "generated_file target requires a name")
		elf.assert(elf.is_string(description.output), "generated_file target requires an output")
		program := description.program
		program_path := program
		dependencies := (description.dependencies ?? []):slice()
		inputs := (description.inputs ?? []):slice()
		if elf.is_string(program) == false ? {
			elf.assert(elf.type_of(program) == "table" && elf.is_string(program.output), "generated file program must be a path or executable target")
			program_path = program.output
			dependencies:add(program.task)
			inputs:add(program.output)
		}

		output := f"${output_directory}/${description.output}"
		elf.assert(elf.fs.create_directories(path_directory(output)), f"could not create output directory for '${output}'")
		arguments := description.arguments ?? []
		argument_type := elf.type_of(arguments)
		if argument_type == "function" || argument_type == "closure" ? { arguments = arguments(output) }
		elf.assert(elf.type_of(arguments) == "array", "generated file arguments must be an array or function")
		task := {
			name = description.name,
			exec = program_path,
			args = arguments,
			inputs = inputs,
			outputs = [ output ],
			include_dirs = [],
			dependencies = dependencies,
		}
		ret { kind = "generated_file", path = output, output = output, task = task }
	}

	run := fun(description) {
		target := description.target
		elf.assert(elf.type_of(target) == "table" && target.kind == "executable", "run target requires an executable target")
		arguments := description.arguments ?? []
		task := {
			name = description.name ?? f"run ${target.name}",
			exec = target.output,
			args = arguments,
			inputs = [ target.output ],
			outputs = [],
			include_dirs = [],
			dependencies = [ target.task ],
		}
		ret { name = task.name, kind = "run", task = task }
	}

	test := fun(description) {
		target := executable(description)
		ret {
			name = target.name,
			kind = "test",
			output = target.output,
			build_task = target.task,
			task = run({ target = target, name = f"test ${target.name}", arguments = description.arguments ?? [] }).task,
		}
	}

	lower_project := fun(project) {
		elf.assert(elf.type_of(project) == "table", "c.project_to_tasks requires a project table")
		elf.assert(elf.type_of(project.targets) == "table", "c.project_to_tasks requires a targets table")

		owners := {}
		visited_projects := {}
		index_project := fun(current) {
			if visited_projects[current] != nil ? ret
			visited_projects[current] = true
			elf.assert(elf.type_of(current.targets) == "table", "project requires a targets table")
			for name := current.targets:keys()[...] ? { owners[current.targets[name]] = current }
			subprojects := current.subprojects ?? {}
			for name := subprojects:keys()[...] ? { recurse(subprojects[name]) }
		}
		index_project(project)

		root_path := fun(owner, path) {
			root := owner.root ?? "."
			if root == "." || root == "" ? ret path
			ret f"${root}/${path}"
		}

		root_paths := fun(owner, paths) {
			ret paths:map(fun(path) ret root_path(owner, path))
		}

		generated := {}
		lower := fun(description) {
			elf.assert(elf.type_of(description) == "table", "project targets must be tables")
			if description.targets != nil ? {
				elf.assert(description.default_target != nil, f"project '${description.name}' requires a default target")
				ret recurse(description.default_target)
			}
			cached := generated[description]
			if cached != nil ? ret cached

			owner := owners[description]
			elf.assert(owner != nil, f"target '${description.name}' does not belong to the project tree")
			kind := description.kind
			lowered := clone_table(description)
			if kind == "generated_file" ? {
				lowered.inputs = root_paths(owner, description.inputs ?? [])
				lowered.dependencies = []
				for dependency := (description.dependencies ?? [])[...] ? {
					lowered.dependencies:add(recurse(dependency).task)
				}
				if elf.is_string(description.program) ? { lowered.program = root_path(owner, description.program) }
				else { lowered.program = recurse(description.program) }
				cached = generated_file(lowered)
			}
			else if kind == "run" ? {
				lowered.target = recurse(description.target)
				cached = run(lowered)
			}
			else {
				lowered.sources = []
				for source := (description.sources ?? [])[...] ? {
					if elf.is_string(source) ? { lowered.sources:add(root_path(owner, source)) }
					else if source.kind == "generated_file" ? { lowered.sources:add(recurse(source)) }
					else {
						rooted := clone_table(source)
						rooted.path = root_path(owner, source.path)
						rooted.generated_inputs = []
						for input := (source.generated_inputs ?? [])[...] ? {
							rooted.generated_inputs:add(recurse(input))
						}
						lowered.sources:add(rooted)
					}
				}
				lowered.private_include_directories = root_paths(owner, description.private_include_directories ?? [])
				lowered.public_include_directories = root_paths(owner, description.public_include_directories ?? [])
				lowered.dependencies = []
				for dependency := (description.dependencies ?? [])[...] ? {
					lowered.dependencies:add(recurse(dependency))
				}

				if kind == "static_library" ? { cached = static_library(lowered) }
				else if kind == "executable" ? { cached = executable(lowered) }
				else if kind == "test" ? { cached = test(lowered) }
				else { elf.assert(false, f"c.project_to_tasks: unknown target kind '${kind}'") }
			}

			generated[description] = cached
			ret cached
		}

		targets := {}
		for name := project.targets:keys()[...] ? {
			elf.assert(elf.is_string(name), "project target names must be strings")
			targets[name] = lower(project.targets[name]).task
		}

		default_task := nil
		if project.default_target != nil ? { default_task = lower(project.default_target).task }
		ret {
			name = project.name,
			default_task = default_task,
			targets = targets,
		}
	}

	ret lower_project(project)
}

ret { project_to_tasks = project_to_tasks }

